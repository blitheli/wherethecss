# 环境变量示例（复制为 .env 后按需填写；不要提交真实密钥）

# Google Map Tiles API Key（可选）
# 配置后「天宫 3D」优先使用 Google Photorealistic 3D Tiles（真 3D Tiles + 地形网格）
# 申请: https://developers.google.com/maps/documentation/tile/3d-tiles
# VITE_GOOGLE_MAP_API_KEY=your_api_key_here

# 可选：覆盖 XYZ 椭球影像模板（无 Google key 时的默认地球）
# 默认 ESRI World Imagery（见 app/lib/tiles/globeDefaults.ts）
# VITE_GLOBE_XYZ_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# ASTROX Web API 根地址（可见性 AccessComputeV2）
# 默认 http://astrox.cn:8765
# VITE_ASTROX_BASE_URL=http://astrox.cn:8765

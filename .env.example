# 环境变量示例（复制为 .env 后按需填写；不要提交真实密钥）

# Google Maps Platform API Key（可选，Photorealistic / Map Tiles）
# VITE_GOOGLE_MAP_API_KEY=your_api_key_here

# Cesium Ion API Token（可选；未设置时使用 CesiumJS 默认演示令牌，有效期见 README）
# 申请: https://ion.cesium.com/
# VITE_CESIUM_ION_TOKEN=your_cesium_token_here

# ASTROX Web API 根地址（可见性 AccessComputeV2）
# 默认 http://astrox.cn:8765
# VITE_ASTROX_BASE_URL=http://astrox.cn:8765

# 地球瓦片模式: ion-3dtiles | xyz-imagery
# VITE_GLOBE_SOURCE=ion-3dtiles
